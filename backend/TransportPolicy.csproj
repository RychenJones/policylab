<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>TransportPolicy.WebHost</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../frontend/index.html;../frontend/app.js;../frontend/api.js;../frontend/styles.css"
             Link="wwwroot/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
